{
  "name": "cappus-demo-sfx",
  "width": 1080,
  "height": 1920,
  "fps": 30,
  "styles": {
    "title": {
      "size": 14, "bold": true, "color": "#FFFFFF", "y": 0.55,
      "stroke": {"color": "#000000", "width": 45},
      "intro": {"name": "zoom_in", "duration": 0.35}, "outro": {"name": "fade_out", "duration": 0.25}
    }
  },
  "video": [
    {
      "id": "hook", "src": "media/landscape.mp4", "in": 0.5, "out": 3.0, "fit": "cover",
      "transition": {"name": "white_flash", "duration": 0.3, "sfx": "whoosh"}
    },
    {
      "id": "b", "src": "media/vertical.mp4", "in": 1.0, "out": 3.0,
      "transition": {"name": "glitch", "sfx": "whoosh"}
    },
    {
      "id": "wide", "src": "media/landscape.mp4", "in": 4.0, "out": 6.0,
      "fit": "contain", "background": "blur",
      "transition": {"name": "dissolve", "sfx": {"sound": "whoosh", "gain": -3}}
    },
    {"id": "still", "src": "media/photo.png", "duration": 2.5, "fit": "cover"}
  ],
  "audio": [
    {"src": "media/music.mp3", "at": 0, "end": "end", "volume": 0.5, "fade": {"in": 0.3, "out": 1.0}}
  ],
  "texts": [
    {"text": "CAPPUS", "at": 0.2, "end": "@hook.end-0.2", "style": "title", "sfx": "pop"},
    {"text": "with sound", "at": "@wide+0.2", "duration": 1.6, "style": "title", "size": 10, "sfx": "pop"},
    {"text": "FOLLOW", "at": "@still+0.5", "end": "end", "style": "title", "sfx": "hit"}
  ],
  "sfx": [
    {"sound": "riser", "at": "@still+0.5"},
    {"sound": "tick", "at": "@wide+1.2"}
  ]
}
